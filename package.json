{
  "name": "chantierpilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ChantierPilot — SaaS de gestion de chantiers pour les entreprises de BTP en Côte d'Ivoire",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/dev.mjs",
    "dev:web": "vite",
    "build": "node scripts/build-vercel.mjs && vite build",
    "preview": "vite preview",
    "migrate": "node db/migrate.mjs",
    "monitor": "node scripts/monitor.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "db:test-rls": "node tests/helpers/isolated-exec.mjs db/test-rls.mjs",
    "test:migration": "node tests/helpers/isolated-exec.mjs tests/migration-neon.mjs",
    "test": "node tests/helpers/isolated-exec.mjs tests/run.mjs",
    "test:unit": "node tests/helpers/isolated-exec.mjs tests/unit.mjs",
    "test:ui": "node tests/helpers/isolated-exec.mjs tests/landing.mjs",
    "test:all": "npm run check:assets && npm run db:test-rls && npm run test:migration && npm run test:unit && npm run test:ui && npm run test && npm run test:theme && npm run test:features",
    "test:browser": "node tests/helpers/isolated-exec.mjs tests/browser-business.mjs && node tests/helpers/isolated-exec.mjs tests/browser-interactions.mjs",
    "test:theme": "node tests/helpers/isolated-exec.mjs tests/browser-theme.mjs",
    "test:features": "node tests/helpers/isolated-exec.mjs tests/browser-features.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "jose": "^6.0.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "embedded-postgres": "^17.5.0-beta.15",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
