# --- Base de données -------------------------------------------------
# URL de connexion APPLICATIVE (rôle LIMITÉ, jamais superuser) :
# l'API s'interdit catégoriquement un rôle qui pourrait contourner le RLS.
# Format Neon : postgresql://chantierpilot_app:<MOT_DE_PASSE>@<ep>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# URL d'administration (propriétaire, ex. neondb_owner) — migrations SQL UNIQUEMENT.
# Lue en priorité par db/migrate.mjs et npm run dev. Ne la mettez JAMAIS dans Vercel.
# Mot de passe : lettres, chiffres, - et _ uniquement (sinon encodez @ → %40, # → %23).
DATABASE_URL_ADMIN=

# Mot de passe du rôle applicatif chantierpilot_app (utilisé par la migration).
# 24 caractères ou plus : lettres, chiffres, - et _. Différent pour chaque base (dev, preprod, prod).
APP_DB_PASSWORD=

# Pilote de base : neon (WebSocket @neondatabase/serverless) ou pg (TCP classique).
# Détection automatique : 'neon' si l'URL contient neon.tech, sinon 'pg'.
# DB_DRIVER=neon

# --- Application ------------------------------------------------------
# Origines autorisées pour les requêtes d'état (anti-CSRF), séparées par des virgules.
# Par défaut, l'origine de la requête doit correspondre à l'en-tête Host.
# ALLOWED_ORIGINS=https://mon-app.vercel.app

# Port de l'API locale (développement).
# API_PORT=8787

# Port PostgreSQL embarqué (développement sans Neon).
# PG_PORT=55432

# --- Paiements d’abonnement SasPay (uniquement côté serveur) -----------
# Origine publique canonique, HTTPS en production.
APP_URL=
# Clé payin/All : sk_test_... en test, sk_live_... en production.
SASPAY_SECRET_KEY=
# Secret du webhook transaction.success, créé depuis app.saspay.me.
SASPAY_WEBHOOK_SECRET=
